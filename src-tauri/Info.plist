<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The camera thread polls continuously; App Nap would slow it when the window is behind others. -->
  <key>NSAppSleepDisabled</key>
  <true/>
  <!-- The Liquid Glass icon in Resources/Assets.car (tools/art/build_app_icon.sh).
       CFBundleIconFile, set by Tauri, keeps icon.icns for macOS before 26. -->
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <!-- Wireless tether: discovery and the camera connection are on the local network. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Ukiyo finds and connects to your camera over Wi-Fi when it is set to wireless tether.</string>
</dict>
</plist>
