{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ukiyo",
  "version": "0.1.0",
  "identifier": "com.nkmkdigital.ukiyo",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:4823",
    "beforeDevCommand": { "script": "cd app && pnpm dev", "wait": false },
    "beforeBuildCommand": "cd app && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ukiyo",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:4823 ws://localhost:4823"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Photography",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": { "../catalog/": "catalog/" },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "files": { "Resources/Assets.car": "icons/Assets.car" },
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "UKIYO_UPDATER_PUBKEY_PLACEHOLDER",
      "endpoints": ["https://github.com/noahkiss/ukiyo/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
